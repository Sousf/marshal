# systemd user unit for the MARSHAL daemon.
#
#   mkdir -p ~/.config/systemd/user
#   cp packaging/marshal.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now marshal
#   journalctl --user -u marshal -f
#
# Needs `loginctl enable-linger $USER` so it runs when you are not logged in,
# and `claude` and `gh` authenticated for the user running it.

[Unit]
Description=MARSHAL fleet maintainer
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/marshal serve
Restart=on-failure
RestartSec=30
# The daemon's own state only. It clones into $MARSHAL_STATE/work.
Environment=MARSHAL_CONFIG=%h/.config/marshal/fleet.yaml
Environment=MARSHAL_STATE=%h/.local/share/marshal
# gh, claude and go live under ~/.local/bin and ~/go/bin for a user install,
# or in Homebrew on Linux. The verifier runs go itself, so go must resolve.
Environment=PATH=%h/.local/bin:%h/go/bin:/usr/local/go/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
# Optional secrets for the service, e.g. ANTHROPIC_API_KEY=..., mode 600.
EnvironmentFile=-%h/.config/marshal/env
# gh and claude keep credentials under the home directory, so the home
# stays readable; everything else is locked down.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h/.local/share/marshal %h/.config/gh %h/.claude %h/.claude.json %h/.cache %h/go
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=default.target
