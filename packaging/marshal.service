# systemd user unit for the MARSHAL daemon.
#
#   mkdir -p ~/.config/systemd/user
#   cp packaging/marshal.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now marshal
#   journalctl --user -u marshal -f
#
# Needs `loginctl enable-linger $USER` so it runs when you are not logged in,
# and `claude` and `gh` authenticated for the user running it.

[Unit]
Description=MARSHAL fleet maintainer
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/marshal serve
Restart=on-failure
RestartSec=30
# The daemon's own state only. It clones into $MARSHAL_STATE/work.
Environment=MARSHAL_CONFIG=%h/.config/marshal/fleet.yaml
Environment=MARSHAL_STATE=%h/.local/share/marshal
# gh and claude keep credentials under the home directory, so the home
# stays readable; everything else is locked down.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h/.local/share/marshal %h/.config/gh %h/.claude %h/.cache
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=default.target
